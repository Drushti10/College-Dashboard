# DocuMind AI - Environment Variables
# Copy this file to .env and insert your API key(s)
# Note: You only need ONE of the following API keys, or choose "Offline / Local Mode" in the app!

# 1. Groq API Key (Recommended for speed & free tier: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# 2. Google Gemini API Key (Free tier available at: https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# 3. OpenAI API Key (Optional: https://platform.openai.com)
OPENAI_API_KEY=your_openai_api_key_here
